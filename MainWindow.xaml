<Window x:Class="MusicRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicRecorder · 音乐内录工具"
        Height="760" Width="900" MinHeight="680" MinWidth="780"
        Background="{StaticResource BgBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 免责声明 -->
            <RowDefinition Height="Auto" />   <!-- 导出路径 -->
            <RowDefinition Height="Auto" />   <!-- 播放器 / 设备 / 码率 -->
            <RowDefinition Height="*" />      <!-- 当前歌曲 -->
            <RowDefinition Height="Auto" />   <!-- 录制选项（勾选框） -->
            <RowDefinition Height="Auto" />   <!-- 状态 + 开始录制 -->
        </Grid.RowDefinitions>

        <!-- ==================== 免责声明 ==================== -->
        <Border Grid.Row="0" CornerRadius="8" Padding="14,10"
                Background="#22E03B3B" BorderBrush="#FFE03B3B" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="⚠ 免责声明：本项目仅供学习与技术交流使用，严禁任何形式的商业用途。"
                           Foreground="#FFFF5A5A" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#FFE3A3A3"
                           Text="录制的音频仅限个人合法使用；请勿传播、售卖或用于任何盈利场景，并请遵守各音乐平台的版权与会员协议。" />
            </StackPanel>
        </Border>

        <!-- ==================== 导出路径 ==================== -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,14" Margin="0,12,0,0"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="① 导出路径（录制完成后 MP3 保存到这里，文件名 = 歌曲名）"
                           Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OutputFolderBox" Grid.Column="0" Height="34"
                             Style="{StaticResource TextBoxStyle}" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="浏览…" Height="34" Margin="8,0,0,0"
                            Style="{StaticResource FlatButton}" Click="BrowseButton_Click" />
                    <Button x:Name="OpenFolderButton" Grid.Column="2" Content="打开目录" Height="34" Margin="8,0,0,0"
                            Style="{StaticResource FlatButton}" Click="OpenFolderButton_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ==================== 播放器 / 设备 / 码率 ==================== -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,14" Margin="0,12,0,0"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="176" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="目标播放器" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="PlayerCombo" Style="{StaticResource ComboStyle}"
                              SelectionChanged="PlayerCombo_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="录音设备（系统声音输出设备）" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="DeviceCombo" Style="{StaticResource ComboStyle}" />
                </StackPanel>

                <Button x:Name="RefreshDeviceButton" Grid.Column="2" Content="刷新" Height="34" Margin="8,20,0,0"
                        VerticalAlignment="Top" Style="{StaticResource FlatButton}" Click="RefreshDeviceButton_Click" />

                <StackPanel Grid.Column="4" Margin="14,0,0,0">
                    <TextBlock Text="MP3 码率" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="BitrateCombo" Style="{StaticResource ComboStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 中部：当前歌曲 ==================== -->
        <!-- ClipToBounds：窗口被压到很矮时，歌曲信息在本面板内裁切，不会盖到上面的选项和下面的录制按钮 -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="20,18" Margin="0,12,0,0"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="SongTitleText" Text="未检测到播放器" FontSize="23" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SongArtistText" Grid.Row="1" Margin="0,7,0,0" FontSize="13.5"
                           Foreground="{StaticResource SubTextBrush}" TextTrimming="CharacterEllipsis"
                           Text="请打开 QQ音乐 / 网易云音乐 / 酷狗音乐 并播放歌曲" />

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <ProgressBar x:Name="SongProgress" Style="{StaticResource BarStyle}" Height="8" Maximum="100" Value="0" />
                    <Grid Margin="0,7,0,0">
                        <TextBlock x:Name="ProgressText" Foreground="{StaticResource SubTextBrush}" FontSize="12" Text="--:-- / --:--" />
                        <TextBlock x:Name="SourceText" HorizontalAlignment="Right" Foreground="{StaticResource SubTextBrush}"
                                   FontSize="12" Text="来源：未检测" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="3" Margin="0,18,0,0" Background="#FF191C21" CornerRadius="8" Padding="14,12"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="RecordStateText" Grid.Column="0" Text="待机中" Foreground="{StaticResource TextBrush}"
                                   FontSize="13" VerticalAlignment="Center" MinWidth="96" />
                        <ProgressBar x:Name="LevelBar" Grid.Column="1" Style="{StaticResource BarStyle}" Height="10"
                                     Margin="14,0" Maximum="100" Value="0" Foreground="#FF3ED07A" />
                        <TextBlock x:Name="RecordedTimeText" Grid.Column="2" Text="00:00" FontFamily="Consolas"
                                   FontSize="17" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <TextBlock x:Name="PlayersText" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" Text="检测到的播放器：—" />
                    <TextBlock x:Name="LastFileText" Foreground="{StaticResource SubTextBrush}" FontSize="12"
                               Margin="0,5,0,0" TextTrimming="CharacterEllipsis" Text="上次导出：—" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ② 录制选项（所有勾选框集中在这里，位于「开始录制」上方） ==================== -->
        <Border Grid.Row="4" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="18,12" Margin="0,12,0,0"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="② 录制选项" Style="{StaticResource FieldLabel}" />
                <WrapPanel>
                    <CheckBox x:Name="AutoRecordCheck" Content="自动录制（点播放即录这一首）" Style="{StaticResource CheckStyle}"
                              IsChecked="False" Margin="0,0,26,7"
                              ToolTip="勾选后：在播放器里点播放，就自动把这一首倒回开头并开始录制，录完自动暂停。&#x0a;不追踪换歌——想连录整张歌单请勾选右边的「自动录制整张歌单」。"
                              Checked="AutoRecordCheck_Changed" Unchecked="AutoRecordCheck_Changed" />
                    <CheckBox x:Name="PlaylistCheck" Content="自动录制整张歌单（换歌接着录，每首单独导出）" Style="{StaticResource CheckStyle}"
                              IsChecked="False" Margin="0,0,26,7"
                              ToolTip="勾选后：点播放开始录制，当前歌曲放完后自动接着录下一首，每首歌单独导出一个 MP3。&#x0a;连录期间不会在每首结束时暂停播放器（否则无法连录）；播放停止或歌单放完即结束。"
                              Checked="PlaylistCheck_Changed" Unchecked="PlaylistCheck_Changed" />
                    <CheckBox x:Name="RestartCheck" Content="自动从头播放" Style="{StaticResource CheckStyle}"
                              IsChecked="True" Margin="0,0,26,7"
                              ToolTip="录制前把歌曲倒回 0:00，保证录到完整的一首（推荐勾选）。" />
                    <CheckBox x:Name="PauseCheck" Content="结束后自动暂停播放" Style="{StaticResource CheckStyle}"
                              IsChecked="True" Margin="0,0,26,7"
                              ToolTip="录制结束后自动暂停播放器，避免继续播下一首（歌单连录时该项不生效）。" />
                    <CheckBox x:Name="OpenFolderCheck" Content="完成后打开文件夹" Style="{StaticResource CheckStyle}"
                              IsChecked="True" Margin="0,0,26,7"
                              ToolTip="录制结束后自动在资源管理器里定位到导出的文件。" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ==================== 底部：开始录制 ==================== -->
        <StackPanel Grid.Row="5" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Text="正在初始化…" Foreground="{StaticResource SubTextBrush}" FontSize="12.5"
                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
            <Button x:Name="RecordButton" Content="●  开始录制" Height="54" Margin="0,10,0,0" FontSize="19"
                    FontWeight="SemiBold" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Background="{StaticResource AccentBrush}" Click="RecordButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <TextBlock x:Name="HintText" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,10,0,0"
                       Foreground="{StaticResource SubTextBrush}" FontSize="11.5" TextWrapping="Wrap"
                       Text="点击“开始录制”后会自动把当前歌曲倒回开头并开始内录；歌曲播放结束会自动停止，并按歌曲名导出 MP3。" />
        </StackPanel>
    </Grid>
</Window>
